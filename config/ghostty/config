# View documentation for the default configuration:
# ghostty +show-config --default --docs
#
# cmd+option+i -> toggles inspector

auto-update-channel = tip
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
# hide password entries with *****
macos-auto-secure-input = true
quit-after-last-window-closed = true
window-save-state = always
auto-update = download
desktop-notifications = true

# visual
theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark
window-theme = dark
# Cyan - cursor-color = #2aa198
cursor-color = #269bd2
font-family = MonoLisa
font-size = 14
window-padding-x = 5
# window-padding-y = 1
cursor-opacity = 0.8
background-opacity = 1.0
background-image-opacity = 0.25
background-blur-radius = 30
background-image-fit = contain
background-image-position = center
custom-shader = shaders/cursor_blaze.glsl
unfocused-split-opacity = .6
mouse-hide-while-typing = true

# ghostty +list-actions
keybind = ctrl+shift+,=open_config
keybind = ctrl+shift+r=reload_config

# Bring back zellij's bottom status bar: when a window ends up taller than the
# screen's visible frame, the last terminal row - where zellij draws zjstatus -
# falls off the bottom edge while Ghostty still reports it to the pty. Zooming
# re-fits the window and the resize makes zellij repaint from scratch. New
# windows avoid this via `maximize = true` below.
keybind = ctrl+shift+m=toggle_maximize

# Unbind ctrl+a - let zellij handle it
keybind = ctrl+a=unbind

# surface
confirm-close-surface = false

# tabs (use cmd for ghostty-native tabs if needed)
window-new-tab-position = end
# Fit new windows to the screen's visible frame. An explicit window-width /
# window-height that overshoots the display gets clamped to the whole screen
# instead, which pushes the last terminal row (zellij's zjstatus gutter) off
# the bottom edge - see the ctrl+shift+m binding above.
maximize = true
resize-overlay = always

# zellij handles splits, navigation, and scrollback
# Forward Option key for Alt keybinds in zellij
macos-option-as-alt = left

# Quake
keybind = global:ctrl+shift+`=toggle_quick_terminal
quick-terminal-animation-duration = 0.1
