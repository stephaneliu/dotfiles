# @use ../../rts/helpers.rts
#
# Requires COCAM_BASE_URL (scheme + host + port) and COCAM_AUTH_TOKEN in the
# environment. resterm resolves {{VAR}} against the OS environment but does
# not interpolate inside resterm.env.json, so the port has to travel with the
# host rather than being appended per request.
#
#   export COCAM_BASE_URL="http://lvhost.me:$COCAM_RAILS_PORT"   # dev
#   export COCAM_BASE_URL="https://app-PR.qa-v2.companycam.com"  # qa

### Index
# @name Index
GET {{COCAM_BASE_URL}}/v3/project_groups.json
Content-Type: application/json
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

### Create
# @name Create
POST {{COCAM_BASE_URL}}/v3/project_groups.json
Content-Type: application/json
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

{
  "project_group": {
    "name": "A new name",
    "description": "A new description"
  }
}

### Show
# @name Show
GET {{COCAM_BASE_URL}}/v3/project_groups/[id].json
Content-Type: application/json
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

### Update
# @name Update
PUT {{COCAM_BASE_URL}}/v3/project_groups/[id].json
Content-Type: application/json
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

{
  "project_group": {
    "name": "Awesome Deal"
  }
}

### Post example
# @name Echo
POST {{COCAM_BASE_URL}}/post
Content-Type: application/json
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

{
  "hello": "resterm",
  "time": "{{$timestampISO8601}}"
}

### Capture value from response
# @name CaptureToken
# @capture file-secret auth.token {{response.json.uuid}}
GET {{COCAM_BASE_URL}}/uuid

### Reuse captured value
# @name UseToken
GET {{COCAM_BASE_URL}}/anything
Authorization: Bearer {{COCAM_AUTH_TOKEN}}

### Query params
# @name Query
# @var request hello resterm
GET {{COCAM_BASE_URL}}/get?hello={{hello}}

### Scripted header
# @name ScriptedHeader
GET {{COCAM_BASE_URL}}/anything
Authorization: {{= helpers.authHeader(vars.get("auth.token"), env.get("COCAM_AUTH_TOKEN")) }}

### Use last response
# @name UseLast
# Uses last.* from the most recent request in this session.
# Run CaptureToken first, otherwise last.json("uuid") is empty.
GET {{COCAM_BASE_URL}}/anything
X-Last-UUID: {{= last.json("uuid") ?? "" }}
