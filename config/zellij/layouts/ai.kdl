// AI layout: equal-size grid of 3 columns x 4 rows (12 panes)

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellaude.wasm"
        }
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#268bd2,bold]{session}"
                format_center "{tabs}"
                format_right  "{command_git_branch} {pipe_status} {notifications} {datetime}"
                format_space  "#[bg=#002b36] "

                mode_normal        "#[bg=#859900,fg=#002b36,bold] NORMAL "
                mode_tmux          "#[bg=#b58900,fg=#002b36,bold] TMUX "
                mode_locked        "#[bg=#dc322f,fg=#002b36,bold] LOCKED "
                mode_scroll        "#[bg=#268bd2,fg=#002b36,bold] SCROLL "
                mode_enter_search  "#[bg=#d33682,fg=#002b36,bold] SEARCH "
                mode_search        "#[bg=#d33682,fg=#002b36,bold] SEARCH "
                mode_rename_tab    "#[bg=#cb4b16,fg=#002b36,bold] RENAME "
                mode_resize        "#[bg=#2aa198,fg=#002b36,bold] RESIZE "
                mode_pane          "#[bg=#2aa198,fg=#002b36,bold] PANE "
                mode_tab           "#[bg=#2aa198,fg=#002b36,bold] TAB "
                mode_session       "#[bg=#2aa198,fg=#002b36,bold] SESSION "

                tab_normal              "#[fg=#839496,bg=#073642] {index}:{name} "
                tab_normal_fullscreen   "#[fg=#839496,bg=#073642] {index}:{name}[] "
                tab_normal_sync         "#[fg=#839496,bg=#073642] {index}:{name}<> "
                tab_active              "#[fg=#002b36,bg=#eee8d5,bold] {index}:{name} "
                tab_active_fullscreen   "#[fg=#002b36,bg=#eee8d5,bold] {index}:{name}[] "
                tab_active_sync         "#[fg=#002b36,bg=#eee8d5,bold] {index}:{name}<> "
                tab_separator           "#[bg=#002b36] "

                command_git_branch_command     "bash -c \"git rev-parse --abbrev-ref HEAD 2>/dev/null\""
                command_git_branch_format      "#[fg=#859900]git:{stdout}"
                command_git_branch_interval    "5"
                command_git_branch_rendermode  "static"

                datetime          "#[fg=#839496]{format}"
                datetime_format   "%a, %d %b %Y %H:%M"
                datetime_timezone "local"

                pipe_status_format "#[fg=#839496]│ {output}"
                pipe_status_rendermode "dynamic"

                notifications_format_unread "#[fg=#268bd2,bg=#073642] {message} "
                notifications_format_no_notifications ""
                notifications_show_interval "10"
            }
        }
    }

    tab name="ai" focus=true {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane name="ai-1"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-1"; }
                pane name="ai-4"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-4"; }
                pane name="ai-7"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-7"; }
                pane name="ai-10" command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-10"; }
            }
            pane split_direction="horizontal" {
                pane name="ai-2"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-2"; }
                pane name="ai-5"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-5"; }
                pane name="ai-8"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-8"; }
                pane name="ai-11" command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-11"; }
            }
            pane split_direction="horizontal" {
                pane name="ai-3"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-3"; }
                pane name="ai-6"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-6"; }
                pane name="ai-9"  command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-9"; }
                pane name="ai-12" command="bash" { args "-c" "exec $HOME/.config/zellij/scripts/ai-pane-restore.sh ai-12"; }
            }
        }
    }

    // Swap layout target for NextSwapLayout. Mirrors the main ai tab's
    // 3-column x 4-row structure plus the top zellaude bar and bottom
    // zjstatus bar from default_tab_template. default_tab_template is NOT
    // applied to tabs inside swap_tiled_layout, so the borderless plugin
    // panes must be re-declared here or they'll get squeezed out.
    // exact_panes=14 = 12 content + 2 plugin bars.
    // Plugins already running aren't re-spawned (existing panes are
    // repositioned), so the zjstatus formatting config doesn't need to be
    // duplicated — just the plugin location.
    // Bound to Ctrl+a R in tmux mode (see config.kdl).
    swap_tiled_layout name="ai-grid-3x4" {
        tab exact_panes=14 {
            pane size=1 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zellaude.wasm"
            }
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
            pane size=1 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zjstatus.wasm"
            }
        }
    }
}
